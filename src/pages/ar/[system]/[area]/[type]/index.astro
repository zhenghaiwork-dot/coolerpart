---
import TypePage from '~/components/pages/TypePage.astro';
import { systemsData } from '~/data/systems';
import { getAllProducts } from '~/data/product-helpers';
import type { System, SystemArea } from '~/data/inquiry-types';

export async function getStaticPaths() {
  const allProducts = await getAllProducts();
  const paths: { params: { system: string; area: string; type: string }; props: { system: System; area: SystemArea; typeSlug: string } }[] = [];
  for (const system of systemsData) {
    for (const area of system.areas) {
      const types = [...new Set(allProducts.filter(p => p.systemSlug === system.slug && p.areaSlug === area.slug).map(p => p.productTypeSlug))];
      for (const typeSlug of types) {
        paths.push({ params: { system: system.slug, area: area.slug, type: typeSlug }, props: { system, area, typeSlug } });
      }
    }
  }
  return paths;
}

const { system, area, typeSlug } = Astro.props;
---
<TypePage system={system} area={area} typeSlug={typeSlug} locale="ar" />
