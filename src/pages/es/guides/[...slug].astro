---
import GuidePostPage from '~/components/pages/GuidePostPage.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const allGuides = await getCollection('guide');
  return allGuides.map((guide) => ({
    params: { slug: guide.id.replace(/\.(md|mdx)$/, '') },
    props: { guide },
  }));
}

const { guide } = Astro.props as { guide: CollectionEntry<'guide'> };
---
<GuidePostPage guide={guide} locale="es" />
