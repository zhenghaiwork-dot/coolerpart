---
/**
 * StructuredData.astro — JSON-LD schemas for SEO (i18n-aware)
 */
import { defaultLang, siteUrl } from '~/i18n/utils';

export interface Props {
  type: 'Organization' | 'BreadcrumbList' | 'Product' | 'Article';
  items?: { name: string; url: string }[];
  product?: {
    name: string;
    description: string;
    image: string;
    category: string;
    sku: string;
    brand?: string;
  };
  article?: {
    title: string;
    description: string;
    image?: string;
    datePublished: string;
    dateModified?: string;
    author?: string;
  };
}

const { type, items, product, article } = Astro.props;
const locale = (Astro.currentLocale as string) || defaultLang;
const baseUrl = siteUrl(Astro.site);

let jsonLd = '';

if (type === 'Organization') {
  const orgNames: Record<string, string> = {
    en: 'EVAPFit',
    ar: 'إيفاب فيت',
    es: 'EVAPFit',
  };
  const orgDescs: Record<string, string> = {
    en: 'Evaporative air cooler replacement parts — interface-matched components for portable and cabinet coolers.',
    ar: 'قطع غيار مبردات الهواء التبخيرية — مكونات متوافقة حسب المقاييس للمبردات المحمولة والخزائنية.',
    es: 'Refacciones para enfriadores de aire evaporativos — componentes compatibles por interfaz para enfriadores portátiles y de gabinete.',
  };
  jsonLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: orgNames[locale] || orgNames.en,
    url: `${baseUrl}${locale !== defaultLang ? '/' + locale : ''}`,
    logo: `${baseUrl}/logo.svg`,
    description: orgDescs[locale] || orgDescs.en,
    email: 'rfq@aircoolerparts.com',
    sameAs: [],
    inLanguage: locale === 'en' ? 'en-US' : locale === 'ar' ? 'ar-SA' : 'es-MX',
  });
}

if (type === 'BreadcrumbList' && items) {
  jsonLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: items.map((item, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: item.name,
      item: `${baseUrl}${item.url}`,
    })),
  });
}

if (type === 'Product' && product) {
  jsonLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    description: product.description,
    image: product.image,
    sku: product.sku,
    category: product.category,
    brand: product.brand ? { '@type': 'Brand', name: product.brand } : undefined,
    inLanguage: locale === 'en' ? 'en-US' : locale === 'ar' ? 'ar-SA' : 'es-MX',
  });
}

if (type === 'Article' && article) {
  jsonLd = JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description: article.description,
    image: article.image || undefined,
    datePublished: article.datePublished,
    dateModified: article.dateModified || article.datePublished,
    author: article.author ? { '@type': 'Organization', name: article.author } : { '@type': 'Organization', name: 'EVAPFit' },
    publisher: {
      '@type': 'Organization',
      name: 'EVAPFit',
      logo: { '@type': 'ImageObject', url: `${baseUrl}/logo.svg` },
    },
    inLanguage: locale === 'en' ? 'en-US' : locale === 'ar' ? 'ar-SA' : 'es-MX',
  });
}
---

{jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd} />}
