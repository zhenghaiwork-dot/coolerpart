---
import { Icon } from 'astro-icon/components';
import { languages, supportedLocales, defaultLang } from '~/i18n/ui';

interface Props {
  currentLocale?: string;
  pathWithoutLocale?: string;
  class?: string;
}

const { currentLocale = defaultLang, pathWithoutLocale = Astro.url.pathname, class: className = '' } = Astro.props;

// Strip locale prefix from path
let cleanPath = pathWithoutLocale;
for (const loc of supportedLocales) {
  if (loc !== defaultLang) {
    if (cleanPath.startsWith(`/${loc}/`)) cleanPath = cleanPath.slice(loc.length + 1);
    else if (cleanPath === `/${loc}`) cleanPath = '/';
  }
}

const availableLocales = supportedLocales.filter((loc) => loc !== currentLocale);

const flagIcon: Record<string, string> = {
  en: 'tabler:world',
  ar: 'tabler:world',
  es: 'tabler:world',
};
---

<div class={`relative inline-flex items-center gap-1.5 ${className}`} data-language-switcher>
  <span class="flex items-center gap-1 text-xs font-semibold text-gray-500 uppercase tracking-wider dark:text-gray-400">
    <Icon name={flagIcon[currentLocale] ?? 'tabler:world'} class="h-3.5 w-3.5" />
    <span class="hidden sm:inline">{currentLocale.toUpperCase()}</span>
  </span>

  {availableLocales.map((loc) => (
    <a
      href={loc === defaultLang ? cleanPath : `/${loc}${cleanPath === '/' ? '' : cleanPath}`}
      class="text-xs text-gray-400 hover:text-teal-600 dark:text-gray-500 dark:hover:text-teal-400 transition-colors"
      title={languages[loc].label}
      hreflang={loc === 'en' ? 'en' : loc}
      lang={loc}
    >
      {loc.toUpperCase()}
    </a>
  ))}
</div>

<script>
  // Store user language preference on click
  function initLanguageSwitcher() {
    const host = document.querySelector('[data-language-switcher]');
    if (!host) return;
    host.addEventListener('click', (e) => {
      const link = (e.target as HTMLElement).closest('a');
      if (link) {
        const lang = link.getAttribute('lang');
        if (lang) {
          try { localStorage.setItem('evapfit_lang', lang); } catch { /* Storage may be disabled. */ }
        }
      }
    });
  }
  initLanguageSwitcher();
</script>
