---
import { Icon } from 'astro-icon/components';
import type { Product } from '~/data/inquiry-types';
import { getAreaName, getProductName, getProductDescription, getSpecLabel, getSpecValue, localeLink, useTranslations, defaultLang } from '~/i18n/utils';

export interface Props {
  product: Product;
  locale?: string;
}

const { product, locale = defaultLang } = Astro.props;
const __ = useTranslations(locale);
const L = (path: string) => localeLink(path, locale);
---

<article
  class="product-card group flex flex-row overflow-hidden rounded-lg border border-gray-200 bg-white transition-all duration-300 hover:border-teal-500 hover:shadow-md dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-teal-400 sm:flex-col sm:rounded-xl"
>
  <!-- Product image -->
  <a
    href={L(`/products/${product.slug}`)}
    class:list={[
      'product-placeholder relative aspect-square w-24 flex-shrink-0 overflow-hidden bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-800 dark:to-slate-700 sm:block sm:aspect-[4/3] sm:w-auto',
      product.image ? 'block' : 'hidden',
    ]}
  >
    <div class="flex h-full w-full items-center justify-center transition-transform duration-500 group-hover:scale-105">
      {product.image ? (
        <img src={product.image} alt={getProductName(product, locale)} class="h-full w-full object-contain p-3" loading="lazy" />
      ) : (
        <Icon name="tabler:package" class="h-8 w-8 text-teal-500/40" />
      )}
    </div>
    <span class="absolute bottom-1.5 left-1.5 max-w-[calc(100%-0.75rem)] truncate rounded bg-slate-950/70 px-1.5 py-0.5 text-[9px] font-medium text-teal-300 sm:bottom-auto sm:left-2.5 sm:top-2.5 sm:px-2 sm:text-[10px]">
      {getAreaName(product.areaSlug, locale)}
    </span>
  </a>

  <!-- Content -->
  <div class="min-w-0 flex flex-1 flex-col p-3 sm:p-4">
    <a href={L(`/products/${product.slug}`)}>
      <h3
        class="text-sm font-semibold text-gray-900 group-hover:text-teal-600 dark:text-white dark:group-hover:text-teal-400 transition-colors leading-snug"
        style="font-family: 'Space Grotesk Variable', sans-serif; letter-spacing: -0.02em;"
      >
        {getProductName(product, locale)}
      </h3>
    </a>

    <p class="mt-1.5 hidden text-xs text-muted line-clamp-2 flex-1 leading-relaxed sm:block">
      {getProductDescription(product, locale)}
    </p>

    <!-- Specs — monospace data table style -->
    <dl class="mt-3 hidden space-y-1 border-t border-gray-100 pt-3 dark:border-slate-700/50 sm:block">
      {product.specs.slice(0, 3).map((spec) => (
        <div class="flex justify-between text-xs">
          <dt class="tech-label text-slate-400">{getSpecLabel(spec.label, locale)}</dt>
          <dd class="font-medium text-gray-800 dark:text-gray-200 tabular-nums" style="font-family: var(--aw-font-mono); font-size: 0.6875rem;">{getSpecValue(spec.value, locale)}</dd>
        </div>
      ))}
    </dl>

    <!-- Footer: MOQ + Action -->
    <div class="mt-auto flex items-center justify-between gap-2 pt-2 sm:mt-3 sm:border-t sm:border-gray-100 sm:pt-3 sm:dark:border-slate-700/50">
      <span class="hidden tech-label text-slate-400 sm:inline">{__('product.moq')} <span class="text-gray-600 dark:text-gray-300 ml-1">{product.moq}</span></span>
      <button
        data-product-slug={product.slug}
        data-product-name={getProductName(product, locale)}
        data-product-category={product.category}
        data-product-type-slug={product.productTypeSlug}
        data-product-moq={product.moq}
        data-product-price={product.priceRange}
        data-product-image={product.image}
        class="add-to-basket-btn inline-flex items-center gap-1 rounded-md bg-slate-900 px-3 py-1.5 text-xs font-medium text-white transition-colors hover:bg-teal-600 dark:bg-teal-600 dark:hover:bg-teal-500"
      >
        <Icon name="tabler:plus" class="h-3 w-3" />
        {__('inquiry.add_to_inquiry')}
      </button>
    </div>
  </div>
</article>
