---
import Layout from '~/layouts/InquiryLayout.astro';
import { Icon } from 'astro-icon/components';
import { getProductsByArea, getProductTypeMeta } from '~/data/product-helpers';
import ProductCard from '~/components/inquiry/ProductCard.astro';
import type { System, SystemArea } from '~/data/inquiry-types';
import { useTranslations, defaultLang, localeLink, getSystemName, getAreaName, getAreaShortDesc, getProductTypeName } from '~/i18n/utils';

export interface Props {
  system: System;
  area: SystemArea;
  locale?: 'en' | 'ar' | 'es';
}

const { system, area, locale = defaultLang } = Astro.props;
const __ = useTranslations(locale);
const L = (path: string) => localeLink(path, locale);

const sysName = getSystemName(system.slug, locale);
const areaName = getAreaName(area.slug, locale);
const areaShortDesc = getAreaShortDesc(area.slug, locale);

const areaMetaTitle = locale === 'es'
  ? `${areaName}: Repuestos para Enfriadores Evaporativos | EVAPFit`
  : locale === 'ar'
    ? `${areaName}: قطع غيار مبرد صحراوي | EVAPFit`
    : `${areaName} Replacement Parts for Evaporative & Swamp Coolers | EVAPFit`;
const areaMetaDescription = locale === 'es'
  ? `Encuentre ${areaName.toLowerCase()} y piezas de repuesto compatibles para enfriadores evaporativos. Compare medidas, conexiones y especificaciones y solicite precio mayorista.`
  : locale === 'ar'
    ? `اعثر على ${areaName} وقطع غيار متوافقة للمبردات الصحراوية. طابق المقاسات والتوصيلات والمواصفات واطلب سعر الجملة.`
    : `Find compatible ${areaName.toLowerCase()} replacement parts for evaporative and swamp coolers. Compare dimensions, connections and specifications, then request bulk pricing.`;
const areaSeoLead = locale === 'es'
  ? `Busque ${areaName.toLowerCase()} por tipo de conexión, dimensiones clave o especificaciones eléctricas, incluso si no conoce el número de modelo del enfriador.`
  : locale === 'ar'
    ? `ابحث عن ${areaName} حسب نوع التوصيل أو المقاسات الأساسية أو المواصفات الكهربائية، حتى إذا لم تعرف رقم موديل المبرد.`
    : `Search ${areaName.toLowerCase()} by connection type, key dimensions or electrical specifications—even when the swamp cooler model number is unavailable.`;
const browseByType = locale === 'es' ? 'Buscar por tipo de producto' : locale === 'ar' ? 'تصفح حسب نوع المنتج' : 'Browse by Product Type';
const selectProductType = locale === 'es' ? 'Seleccione un tipo para ver repuestos compatibles.' : locale === 'ar' ? 'اختر نوع المنتج لعرض قطع الغيار المتوافقة.' : 'Select a product type to view compatible replacement parts.';

const productTypes = await getProductTypeMeta(system.slug, area.slug);
const allProducts = await getProductsByArea(system.slug, area.slug);
const relatedAreas = system.areas.filter((a) => a.slug !== area.slug).slice(0, 4);
---

<Layout metadata={{
  title: areaMetaTitle,
  description: areaMetaDescription,
  ignoreTitleTemplate: true,
}} locale={locale}>
  <!-- Breadcrumb -->
  <div class="border-b border-gray-100 bg-white dark:border-slate-800 dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-6 py-2.5 text-sm text-muted">
      <a href={L('/')} class="hover:text-teal-600">{__('breadcrumb.home')}</a>
      <span class="mx-1.5 text-gray-300">/</span>
      <a href={L(`/${system.slug}`)} class="hover:text-teal-600">{sysName}</a>
      <span class="mx-1.5 text-gray-300">/</span>
      <span class="text-gray-700 dark:text-gray-300">{areaName}</span>
    </div>
  </div>

  <!-- Header -->
  <section class="border-b border-gray-100 bg-white dark:border-slate-800 dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-6 py-10 lg:py-14">
      <p class="text-xs font-medium uppercase tracking-wide text-teal-600 dark:text-teal-400 mb-1">{sysName}</p>
      <h1 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-3xl">{areaName} {__('product.for_evap_coolers')}</h1>
      <p class="mt-2 max-w-2xl text-sm text-muted leading-relaxed">{areaShortDesc}</p>
      <p class="mt-3 text-xs text-muted">{allProducts.length} {__('system.products_count')} · {productTypes.length} {__('system.sub_categories')}</p>
    </div>
  </section>

  <!-- SEO text -->
  <section class="border-b border-gray-100 bg-gray-50 dark:border-slate-800 dark:bg-slate-800/30">
    <div class="mx-auto max-w-7xl px-6 py-4">
      <p class="text-sm text-muted leading-relaxed max-w-3xl">
        {areaSeoLead} <a href={L('/compatibility')} class="text-teal-600 hover:underline">{__('cta.compatibility_guide')} &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Product Types -->
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-6 py-10 lg:py-14">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">{browseByType}</h2>
      <p class="text-sm text-muted mb-6">{selectProductType}</p>
      {productTypes.length > 0 ? (
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {productTypes.map((type) => (
            <a
              href={L(`/${system.slug}/${area.slug}/${type.slug}`)}
              class="group flex items-start gap-3 rounded-lg border border-gray-200 bg-white p-4 transition hover:border-gray-300 hover:shadow-sm dark:border-slate-700 dark:bg-slate-800/50"
            >
              <Icon name={area.icon} class="h-5 w-5 text-teal-500 mt-0.5 flex-shrink-0" />
              <div class="min-w-0">
                <span class="text-sm font-medium text-gray-900 dark:text-white group-hover:text-teal-600">{getProductTypeName(type.slug, locale)}</span>
                <p class="text-xs text-muted mt-0.5 line-clamp-2">{type.description}</p>
                <p class="text-xs text-teal-600 dark:text-teal-400 mt-1">{type.productCount !== 1 ? __('area.product_count').replace('{count}', String(type.productCount)) : __('area.product_count_one').replace('{count}', String(type.productCount))}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-sm text-muted py-8 text-center">{__('area.no_product_types')} <a href={L('/inquiry')} class="text-teal-600 hover:underline">{__('area.submit_inquiry')}</a>.</p>
      )}
    </div>
  </section>

  {/* All Products */}
  {allProducts.length > 0 && (
    <section class="border-t border-gray-100 bg-gray-50 dark:border-slate-700 dark:bg-slate-800/30">
      <div class="mx-auto max-w-7xl px-6 py-10 lg:py-14">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-1">{__('system.all_products_title').replace('{name}', areaName)}</h2>
        <p class="text-sm text-muted mb-6">{allProducts.length} {__('system.compatible_parts')}{allProducts.length !== 1 ? 's' : ''}. {__('system.click_for_specs')}</p>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {allProducts.map((product) => (<ProductCard product={product} locale={locale} />))}
        </div>
      </div>
    </section>
  )}

  {/* Related Areas */}
  {relatedAreas.length > 0 && (
    <section class="border-t border-gray-100 bg-white dark:border-slate-800 dark:bg-slate-900">
      <div class="mx-auto max-w-7xl px-6 py-10 lg:py-14">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-4">{__('system.related_categories').replace('{name}', sysName)}</h2>
        <div class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4">
          {relatedAreas.map((ra) => (
            <a href={L(`/${system.slug}/${ra.slug}`)} class="flex items-center gap-2 rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 hover:border-teal-300 hover:text-teal-600 transition dark:border-slate-700 dark:bg-slate-800/50 dark:text-gray-300">
              <Icon name={ra.icon} class="h-4 w-4 text-teal-500 flex-shrink-0" />
              <span class="truncate">{getAreaName(ra.slug, locale)}</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="bg-slate-950 text-white">
    <div class="mx-auto max-w-3xl px-6 py-12 text-center lg:py-16">
      <h2 class="text-xl font-semibold">{__('area.cant_find')}</h2>
      <p class="mt-3 text-sm text-gray-400 max-w-xl mx-auto">{__('area.send_measurements')}</p>
      <div class="mt-6 flex flex-col items-center gap-2.5 sm:flex-row sm:justify-center">
        <a href={L('/inquiry')} class="rounded-lg bg-teal-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-teal-500">{__('cta.request_quote')}</a>
        <a href={L('/how-to-identify-part-number')} class="rounded-lg border border-white/15 px-5 py-2.5 text-sm font-semibold text-white hover:bg-white/5">{__('area.how_to_identify')}</a>
      </div>
    </div>
  </section>
</Layout>
