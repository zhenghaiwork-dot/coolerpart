---
import Layout from '~/layouts/Layout.astro';
import { useTranslations, defaultLang, localeLink } from '~/i18n/utils';

export interface Props {
  locale?: 'en' | 'ar' | 'es';
}

const { locale = defaultLang } = Astro.props;
const __ = useTranslations(locale);
const L = (path: string) => localeLink(path, locale);

const title = __('404.title') || 'Error 404';
---

<Layout metadata={{ title, robots: { index: false, follow: true } }}>
  <section class="flex items-center h-full p-16">
    <div class="container flex flex-col items-center justify-center px-5 mx-auto my-8">
      <div class="max-w-md text-center">
        <h1 class="mb-8 font-bold text-9xl">
          <span class="sr-only">Error</span>
          <span class="text-primary">404</span>
        </h1>
        <p class="text-3xl font-semibold md:text-3xl">{__('404.not_found') || "Sorry, we couldn't find this page."}</p>
        <p class="mt-4 mb-8 text-lg text-muted dark:text-slate-400">
          {__('404.message') || "But don't worry, you can find plenty of other things on our homepage."}
        </p>
        <a href={L('/')} class="btn ml-4">{__('404.back_home') || 'Back to homepage'}</a>
      </div>
    </div>
  </section>
</Layout>
