---
import Layout from '~/layouts/InquiryLayout.astro';
import { getAllProducts } from '~/data/product-helpers';
import { useTranslations, defaultLang, localeLink, getProductName, getProductDescription } from '~/i18n/utils';

export interface Props {
  locale?: 'en' | 'ar' | 'es';
}

const { locale = defaultLang } = Astro.props;
const __ = useTranslations(locale);
const L = (path: string) => localeLink(path, locale);

const allProducts = await getAllProducts();
const pumps = allProducts.filter(p => p.systemSlug === 'water-system' && p.areaSlug === 'water-pump-power');
---
<Layout metadata={{ title: __('waterpump.title'), ignoreTitleTemplate: true }} locale={locale}>
  <section class="overflow-hidden bg-gradient-to-br from-slate-900 via-teal-900 to-slate-900 text-white">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{__('waterpump.heading')}</h1>
      <p class="mt-4 text-lg text-gray-300">{__('waterpump.desc')}</p>
      <div class="mt-6 flex justify-center gap-3"><a href={L('/water-system/water-pump-power')} class="rounded-xl bg-teal-600 px-6 py-3 text-sm font-semibold text-white hover:bg-teal-700">{__('waterpump.browse_all')}</a><a href={L('/inquiry')} class="rounded-xl border border-gray-500 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10">{__('cta.request_quote')}</a></div>
    </div>
  </section>
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 sm:py-16">
      <h2 class="mb-8 text-2xl font-bold">{__('waterpump.available')} ({pumps.length})</h2>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {pumps.map(p => (
          <a href={L(`/${p.systemSlug}/${p.areaSlug}/${p.productTypeSlug}/${p.slug}`)} class="group rounded-xl border p-5 hover:shadow-md transition-all dark:border-slate-700">
            <h3 class="font-semibold text-gray-900 group-hover:text-teal-600 dark:text-white">{getProductName(p, locale)}</h3>
            <p class="mt-1 text-sm text-muted line-clamp-2">{getProductDescription(p, locale)}</p>
            <div class="mt-2 flex flex-wrap gap-1">{p.specs.slice(0,3).map(s=><span class="rounded bg-gray-100 px-2 py-0.5 text-xs text-muted dark:bg-slate-700">{s.value}</span>)}</div>
            <span class="mt-3 inline-block text-xs text-teal-600">{p.moq} &rarr;</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
