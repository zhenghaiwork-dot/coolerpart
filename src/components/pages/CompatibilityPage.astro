---
import Layout from '~/layouts/InquiryLayout.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations, defaultLang, localeLink } from '~/i18n/utils';

export interface Props {
  locale?: 'en' | 'ar' | 'es';
}

const { locale = defaultLang } = Astro.props;
const __ = useTranslations(locale);
const L = (path: string) => localeLink(path, locale);
---

<Layout metadata={{ title: __('compatibility.title'), ignoreTitleTemplate: true }} locale={locale}>
  <section class="bg-slate-950 text-white">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:py-22">
      <div data-reveal class="max-w-3xl">
        <p class="text-sm font-medium text-teal-400">{__('compatibility.subtitle')}</p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl" style="font-family: 'Space Grotesk Variable', sans-serif; letter-spacing: -0.03em;">
          {__('compatibility.hero_heading')}
        </h1>
        <p class="mt-5 text-lg text-gray-400 max-w-2xl leading-relaxed">
          {__('compatibility.hero_desc')}
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white dark:bg-slate-900 border-b border-gray-100 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-6 py-14 lg:py-18">
      <div data-reveal class="mb-10">
        <h2 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white" style="font-family: 'Space Grotesk Variable', sans-serif; letter-spacing: -0.02em;">
          {__('compatibility.why_title')}
        </h2>
        <p class="mt-3 text-sm text-muted max-w-2xl leading-relaxed">
          {__('compatibility.why_desc')}
        </p>
      </div>
      <div class="grid gap-6 sm:grid-cols-3">
        <div data-reveal data-reveal-delay="1" class="rounded-xl border border-gray-100 p-6 dark:border-slate-800">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-teal-100 dark:bg-teal-900/30">
            <Icon name="tabler:ruler" class="h-5 w-5 text-teal-600 dark:text-teal-400" />
          </div>
          <h3 class="mt-4 text-base font-semibold text-gray-900 dark:text-white">{__('compatibility.measurable')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('compatibility.measurable_desc')}</p>
        </div>
        <div data-reveal data-reveal-delay="2" class="rounded-xl border border-gray-100 p-6 dark:border-slate-800">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-teal-100 dark:bg-teal-900/30">
            <Icon name="tabler:arrows-exchange" class="h-5 w-5 text-teal-600 dark:text-teal-400" />
          </div>
          <h3 class="mt-4 text-base font-semibold text-gray-900 dark:text-white">{__('compatibility.universal')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('compatibility.universal_desc')}</p>
        </div>
        <div data-reveal data-reveal-delay="3" class="rounded-xl border border-gray-100 p-6 dark:border-slate-800">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-teal-100 dark:bg-teal-900/30">
            <Icon name="tabler:shield-check" class="h-5 w-5 text-teal-600 dark:text-teal-400" />
          </div>
          <h3 class="mt-4 text-base font-semibold text-gray-900 dark:text-white">{__('compatibility.reliable')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('compatibility.reliable_desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 dark:bg-slate-800/30">
    <div class="mx-auto max-w-7xl px-6 py-14 lg:py-18">
      <div data-reveal class="mb-10">
        <h2 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white" style="font-family: 'Space Grotesk Variable', sans-serif; letter-spacing: -0.02em;">
          {__('compatibility.four_ways')}
        </h2>
        <p class="mt-2 text-sm text-muted">{__('compatibility.four_ways_desc')}</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <a href={L('/compatibility/interface')} data-reveal data-reveal-delay="1"
          class="group block rounded-xl border border-gray-200 bg-white p-6 transition-all duration-300 hover:border-teal-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-teal-700">
          <Icon name="tabler:plug" class="h-7 w-7 text-teal-600 dark:text-teal-400 transition-transform group-hover:scale-110" />
          <h3 class="mt-4 text-base font-semibold text-gray-900 dark:text-white" style="font-family: 'Space Grotesk Variable', sans-serif;">{__('compatibility.by_interface')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('compatibility.interface_desc')}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-teal-600 dark:text-teal-400">{__('compatibility.interface_browse_link')} <Icon name="tabler:arrow-right" class="h-3 w-3"/></span>
        </a>
        <a href={L('/compatibility/dimensions')} data-reveal data-reveal-delay="2"
          class="group block rounded-xl border border-gray-200 bg-white p-6 transition-all duration-300 hover:border-teal-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-teal-700">
          <Icon name="tabler:ruler" class="h-7 w-7 text-teal-600 dark:text-teal-400 transition-transform group-hover:scale-110" />
          <h3 class="mt-4 text-base font-semibold text-gray-900 dark:text-white" style="font-family: 'Space Grotesk Variable', sans-serif;">{__('compatibility.by_dimensions')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('compatibility.dimensions_desc')}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-teal-600 dark:text-teal-400">{__('compatibility.dimensions_browse_link')} <Icon name="tabler:arrow-right" class="h-3 w-3"/></span>
        </a>
        <a href={L('/compatibility/electrical')} data-reveal data-reveal-delay="3"
          class="group block rounded-xl border border-gray-200 bg-white p-6 transition-all duration-300 hover:border-teal-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-teal-700">
          <Icon name="tabler:chart-bar" class="h-7 w-7 text-teal-600 dark:text-teal-400 transition-transform group-hover:scale-110" />
          <h3 class="mt-4 text-base font-semibold text-gray-900 dark:text-white" style="font-family: 'Space Grotesk Variable', sans-serif;">{__('compatibility.by_electrical')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('compatibility.electrical_desc')}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-teal-600 dark:text-teal-400">{__('compatibility.electrical_browse_link')} <Icon name="tabler:arrow-right" class="h-3 w-3"/></span>
        </a>
        <a href={L('/compatibility/cross-reference')} data-reveal data-reveal-delay="4"
          class="group block rounded-xl border border-gray-200 bg-white p-6 transition-all duration-300 hover:border-teal-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-900/50 dark:hover:border-teal-700">
          <Icon name="tabler:books" class="h-7 w-7 text-teal-600 dark:text-teal-400 transition-transform group-hover:scale-110" />
          <h3 class="mt-4 text-base font-semibold text-gray-900 dark:text-white" style="font-family: 'Space Grotesk Variable', sans-serif;">{__('compatibility.cross_ref')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('compatibility.cross_ref_desc')}</p>
          <span class="mt-4 inline-flex items-center gap-1 text-xs font-medium text-teal-600 dark:text-teal-400">{__('compatibility.cross_ref_browse_link')} <Icon name="tabler:arrow-right" class="h-3 w-3"/></span>
        </a>
      </div>
    </div>
  </section>

  <section class="bg-white dark:bg-slate-900 border-t border-gray-100 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-6 py-14 lg:py-18">
      <div data-reveal class="mb-10">
        <h2 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white" style="font-family: 'Space Grotesk Variable', sans-serif; letter-spacing: -0.02em;">
          {__('compatibility.evidence_title')}
        </h2>
        <p class="mt-2 text-sm text-muted max-w-2xl leading-relaxed">
          {__('compatibility.evidence_desc')}
        </p>
      </div>
      <div class="grid gap-8 lg:grid-cols-2">
        <div data-reveal data-reveal-delay="1">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-4">{__('compatibility.evidence_types')}</h3>
          <div class="space-y-3">
            <div class="flex gap-3 rounded-lg border border-gray-100 p-4 dark:border-slate-800">
              <Icon name="tabler:plug" class="h-5 w-5 text-teal-600 dark:text-teal-400 flex-shrink-0 mt-0.5" />
              <div><p class="text-sm font-medium text-gray-900 dark:text-white">{__('compatibility.evidence_interface')}</p><p class="text-xs text-muted">{__('compatibility.evidence_interface_desc')}</p></div>
            </div>
            <div class="flex gap-3 rounded-lg border border-gray-100 p-4 dark:border-slate-800">
              <Icon name="tabler:ruler" class="h-5 w-5 text-teal-600 dark:text-teal-400 flex-shrink-0 mt-0.5" />
              <div><p class="text-sm font-medium text-gray-900 dark:text-white">{__('compatibility.evidence_dimensional')}</p><p class="text-xs text-muted">{__('compatibility.evidence_dimensional_desc')}</p></div>
            </div>
            <div class="flex gap-3 rounded-lg border border-gray-100 p-4 dark:border-slate-800">
              <Icon name="tabler:bolt" class="h-5 w-5 text-teal-600 dark:text-teal-400 flex-shrink-0 mt-0.5" />
              <div><p class="text-sm font-medium text-gray-900 dark:text-white">{__('compatibility.evidence_electrical')}</p><p class="text-xs text-muted">{__('compatibility.evidence_electrical_desc')}</p></div>
            </div>
          </div>
        </div>
        <div data-reveal data-reveal-delay="2">
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-4">{__('compatibility.confidence_levels')}</h3>
          <div class="space-y-3">
            <div class="flex gap-3 rounded-lg border border-green-200 bg-green-50/50 p-4 dark:border-green-800 dark:bg-green-900/10">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-green-600 text-xs font-bold text-white flex-shrink-0">&#x2713;</span>
              <div><p class="text-sm font-medium text-green-800 dark:text-green-300">{__('compatibility.conf_guaranteed')}</p><p class="text-xs text-green-700 dark:text-green-400">{__('compatibility.conf_guaranteed_desc')}</p></div>
            </div>
            <div class="flex gap-3 rounded-lg border border-amber-200 bg-amber-50/50 p-4 dark:border-amber-800 dark:bg-amber-900/10">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-amber-500 text-xs font-bold text-white flex-shrink-0">~</span>
              <div><p class="text-sm font-medium text-amber-800 dark:text-amber-300">{__('compatibility.conf_most_common')}</p><p class="text-xs text-amber-700 dark:text-amber-400">{__('compatibility.conf_most_common_desc')}</p></div>
            </div>
            <div class="flex gap-3 rounded-lg border border-blue-200 bg-blue-50/50 p-4 dark:border-blue-800 dark:bg-blue-900/10">
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-blue-500 text-xs font-bold text-white flex-shrink-0">?</span>
              <div><p class="text-sm font-medium text-blue-800 dark:text-blue-300">{__('compatibility.conf_needs_check')}</p><p class="text-xs text-blue-700 dark:text-blue-400">{__('compatibility.conf_needs_check_desc')}</p></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 dark:bg-slate-800/30 border-t border-gray-100 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-6 py-14 lg:py-18">
      <div data-reveal class="mb-10">
        <h2 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white" style="font-family: 'Space Grotesk Variable', sans-serif; letter-spacing: -0.02em;">
          {__('compatibility.step_title')}
        </h2>
        <p class="mt-2 text-sm text-muted">{__('compatibility.step_desc')}</p>
      </div>
      <div class="grid gap-8 md:grid-cols-2 max-w-4xl">
        <div data-reveal data-reveal-delay="1">
          <span class="text-3xl font-bold text-teal-600/25 dark:text-teal-400/20" style="font-family: 'Space Grotesk Variable', sans-serif;">01</span>
          <h3 class="mt-3 text-lg font-semibold text-gray-900 dark:text-white">{__('compatibility.step1_title')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('compatibility.step1_desc')}</p>
        </div>
        <div data-reveal data-reveal-delay="2">
          <span class="text-3xl font-bold text-teal-600/25 dark:text-teal-400/20" style="font-family: 'Space Grotesk Variable', sans-serif;">02</span>
          <h3 class="mt-3 text-lg font-semibold text-gray-900 dark:text-white">{__('compatibility.step2_title')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('compatibility.step2_desc')}</p>
        </div>
        <div data-reveal data-reveal-delay="3">
          <span class="text-3xl font-bold text-teal-600/25 dark:text-teal-400/20" style="font-family: 'Space Grotesk Variable', sans-serif;">03</span>
          <h3 class="mt-3 text-lg font-semibold text-gray-900 dark:text-white">{__('compatibility.step3_title')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('compatibility.step3_desc')}</p>
        </div>
        <div data-reveal data-reveal-delay="4">
          <span class="text-3xl font-bold text-teal-600/25 dark:text-teal-400/20" style="font-family: 'Space Grotesk Variable', sans-serif;">04</span>
          <h3 class="mt-3 text-lg font-semibold text-gray-900 dark:text-white">{__('compatibility.step4_title')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('compatibility.step4_desc')}</p>
        </div>
      </div>

      <div data-reveal class="mt-12 flex flex-col sm:flex-row gap-3">
        <a href={L('/how-to-identify-part-number')} class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-teal-500">
          {__('compatibility.full_guide_cta')} <Icon name="tabler:arrow-right" class="h-4 w-4"/>
        </a>
        <a href={L('/inquiry')} class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-6 py-3 text-sm font-semibold text-gray-700 transition-colors hover:bg-gray-50 dark:border-slate-600 dark:bg-slate-800 dark:text-gray-300 dark:hover:bg-slate-700">
          <Icon name="tabler:mail" class="h-4 w-4"/> {__('compatibility.not_sure_cta')}
        </a>
      </div>
    </div>
  </section>

  <section class="bg-slate-950 text-white">
    <div class="mx-auto max-w-3xl px-6 py-16 text-center lg:py-20">
      <h2 class="text-2xl font-semibold tracking-tight" style="font-family: 'Space Grotesk Variable', sans-serif; letter-spacing: -0.02em;">
        {__('compatibility.cta_title')}
      </h2>
      <p class="mt-4 text-base text-gray-400 max-w-xl mx-auto leading-relaxed">
        {__('compatibility.cta_desc')}
      </p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a href={L('/inquiry')} class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-teal-500">
          <Icon name="tabler:mail" class="h-4 w-4"/> {__('compatibility.request_quote')}
        </a>
        <a href={L('/compatibility/interface')} class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/5">
          {__('compatibility.start_matching')} <Icon name="tabler:arrow-right" class="h-4 w-4"/>
        </a>
      </div>
    </div>
  </section>
</Layout>
