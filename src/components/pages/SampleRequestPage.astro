---
import Layout from '~/layouts/InquiryLayout.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations, defaultLang, localeLink } from '~/i18n/utils';

export interface Props {
  locale?: 'en' | 'ar' | 'es';
}

const { locale = defaultLang } = Astro.props;
const __ = useTranslations(locale);
const L = (path: string) => localeLink(path, locale);
---

<Layout metadata={{ title: __('sample.title'), ignoreTitleTemplate: true }} locale={locale}>
  <section class="bg-slate-950 text-white">
    <div class="mx-auto max-w-7xl px-6 py-16 lg:py-20">
      <div data-reveal class="max-w-3xl">
        <p class="text-sm font-medium text-teal-400">{__('sample.hero_subtitle')}</p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl" style="font-family: 'Space Grotesk Variable', sans-serif; letter-spacing: -0.03em;">
          {__('sample.hero_heading')}
        </h1>
        <p class="mt-5 text-lg text-gray-400 max-w-2xl leading-relaxed">
          {__('sample.hero_desc')}
        </p>
      </div>
    </div>
  </section>

  <section class="bg-white dark:bg-slate-900 border-b border-gray-100 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-6 py-14 lg:py-18">
      <div data-reveal class="mb-10">
        <h2 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white" style="font-family: 'Space Grotesk Variable', sans-serif; letter-spacing: -0.02em;">
          {__('sample.how_title')}
        </h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div data-reveal data-reveal-delay="1" class="rounded-xl border border-gray-100 p-6 dark:border-slate-800">
          <span class="text-3xl font-bold text-teal-600/25 dark:text-teal-400/20" style="font-family: 'Space Grotesk Variable', sans-serif;">01</span>
          <h3 class="mt-3 text-base font-semibold text-gray-900 dark:text-white">{__('sample.step1_title')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('sample.step1_desc')}</p>
        </div>
        <div data-reveal data-reveal-delay="2" class="rounded-xl border border-gray-100 p-6 dark:border-slate-800">
          <span class="text-3xl font-bold text-teal-600/25 dark:text-teal-400/20" style="font-family: 'Space Grotesk Variable', sans-serif;">02</span>
          <h3 class="mt-3 text-base font-semibold text-gray-900 dark:text-white">{__('sample.step2_title')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('sample.step2_desc')}</p>
        </div>
        <div data-reveal data-reveal-delay="3" class="rounded-xl border border-gray-100 p-6 dark:border-slate-800">
          <span class="text-3xl font-bold text-teal-600/25 dark:text-teal-400/20" style="font-family: 'Space Grotesk Variable', sans-serif;">03</span>
          <h3 class="mt-3 text-base font-semibold text-gray-900 dark:text-white">{__('sample.step3_title')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('sample.step3_desc')}</p>
        </div>
        <div data-reveal data-reveal-delay="4" class="rounded-xl border border-gray-100 p-6 dark:border-slate-800">
          <span class="text-3xl font-bold text-teal-600/25 dark:text-teal-400/20" style="font-family: 'Space Grotesk Variable', sans-serif;">04</span>
          <h3 class="mt-3 text-base font-semibold text-gray-900 dark:text-white">{__('sample.step4_title')}</h3>
          <p class="mt-2 text-sm text-muted leading-relaxed">{__('sample.step4_desc')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 dark:bg-slate-800/30 border-b border-gray-100 dark:border-slate-800">
    <div class="mx-auto max-w-7xl px-6 py-14 lg:py-18">
      <div class="grid gap-10 lg:grid-cols-2">
        <div data-reveal>
          <h2 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white mb-6" style="font-family: 'Space Grotesk Variable', sans-serif; letter-spacing: -0.02em;">
            {__('sample.cost_title')}
          </h2>
          <div class="space-y-4">
            <div class="flex gap-3 rounded-lg border border-gray-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900/50">
              <Icon name="tabler:coin" class="h-5 w-5 text-teal-600 dark:text-teal-400 flex-shrink-0 mt-0.5" />
              <div>
                <p class="text-sm font-medium text-gray-900 dark:text-white">{__('sample.cost_unit')}</p>
                <p class="text-xs text-muted mt-0.5">{__('sample.cost_unit_desc')}</p>
              </div>
            </div>
            <div class="flex gap-3 rounded-lg border border-gray-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-900/50">
              <Icon name="tabler:plane" class="h-5 w-5 text-teal-600 dark:text-teal-400 flex-shrink-0 mt-0.5" />
              <div>
                <p class="text-sm font-medium text-gray-900 dark:text-white">{__('sample.cost_shipping')}</p>
                <p class="text-xs text-muted mt-0.5">{__('sample.cost_shipping_desc')}</p>
              </div>
            </div>
            <div class="flex gap-3 rounded-lg border border-green-200 bg-green-50/50 p-4 dark:border-green-800 dark:bg-green-900/10">
              <Icon name="tabler:arrow-back-up" class="h-5 w-5 text-green-600 dark:text-green-400 flex-shrink-0 mt-0.5" />
              <div>
                <p class="text-sm font-medium text-green-800 dark:text-green-300">{__('sample.cost_refund')}</p>
                <p class="text-xs text-green-700 dark:text-green-400 mt-0.5">{__('sample.cost_refund_desc')}</p>
              </div>
            </div>
          </div>
        </div>

        <div data-reveal data-reveal-delay="1">
          <h2 class="text-2xl font-semibold tracking-tight text-gray-900 dark:text-white mb-6" style="font-family: 'Space Grotesk Variable', sans-serif; letter-spacing: -0.02em;">
            {__('sample.faq_title')}
          </h2>
          <div class="space-y-3">
            <details class="group rounded-lg border border-gray-200 bg-white dark:border-slate-700 dark:bg-slate-900/50">
              <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium text-gray-900 dark:text-white">{__('sample.faq_q1')}</summary>
              <div class="px-4 pb-3 text-xs text-muted">{__('sample.faq_a1')}</div>
            </details>
            <details class="group rounded-lg border border-gray-200 bg-white dark:border-slate-700 dark:bg-slate-900/50">
              <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium text-gray-900 dark:text-white">{__('sample.faq_q2')}</summary>
              <div class="px-4 pb-3 text-xs text-muted">{__('sample.faq_a2')}</div>
            </details>
            <details class="group rounded-lg border border-gray-200 bg-white dark:border-slate-700 dark:bg-slate-900/50">
              <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium text-gray-900 dark:text-white">{__('sample.faq_q3')}</summary>
              <div class="px-4 pb-3 text-xs text-muted">{__('sample.faq_a3')}</div>
            </details>
            <details class="group rounded-lg border border-gray-200 bg-white dark:border-slate-700 dark:bg-slate-900/50">
              <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium text-gray-900 dark:text-white">{__('sample.faq_q4')}</summary>
              <div class="px-4 pb-3 text-xs text-muted">{__('sample.faq_a4')}</div>
            </details>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-slate-950 text-white">
    <div class="mx-auto max-w-3xl px-6 py-16 text-center lg:py-20">
      <h2 class="text-2xl font-semibold tracking-tight" style="font-family: 'Space Grotesk Variable', sans-serif; letter-spacing: -0.02em;">
        {__('sample.cta_title')}
      </h2>
      <p class="mt-4 text-base text-gray-400 max-w-xl mx-auto leading-relaxed">
        {__('sample.cta_desc')}
      </p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a href={L('/inquiry')} class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-teal-500">
          <Icon name="tabler:mail" class="h-4 w-4"/> {__('sample.request_cta')}
        </a>
        <a href={L('/all-products')} class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/5">
          {__('sample.browse_cta')} <Icon name="tabler:arrow-right" class="h-4 w-4"/>
        </a>
      </div>
    </div>
  </section>
</Layout>
