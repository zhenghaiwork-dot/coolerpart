---
import Layout from '~/layouts/InquiryLayout.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations, defaultLang, localeLink } from '~/i18n/utils';

export interface Props {
  locale?: 'en' | 'ar' | 'es';
}

const { locale = defaultLang } = Astro.props;
const __ = useTranslations(locale);
const L = (path: string) => localeLink(path, locale);
---

<Layout metadata={{ title: __('quality.title'), description: __('quality.desc'), ignoreTitleTemplate: true }} locale={locale}>
  <section class="overflow-hidden bg-gradient-to-br from-slate-900 via-emerald-900 to-slate-900 text-white">
    <div class="mx-auto max-w-3xl px-4 py-16 text-center sm:px-6 sm:py-20">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{__('quality.heading')}</h1>
      <p class="mt-4 text-lg text-gray-300">{__('quality.subtitle')}</p>
    </div>
  </section>
  <section class="bg-white dark:bg-slate-900">
    <div class="mx-auto max-w-4xl px-4 py-12 sm:px-6 sm:py-16">
      <div class="prose dark:prose-invert max-w-none space-y-6">
        <h2>{__('quality.quality_management')}</h2>
        <p>{__('quality.quality_mgmt_text')}</p>
        <div class="grid gap-4 sm:grid-cols-3 not-prose text-center">
          <div class="rounded-xl border p-5"><div class="text-2xl font-bold text-emerald-600">IQC</div><p class="text-sm text-muted mt-1">{__('quality.iqc')}</p></div>
          <div class="rounded-xl border p-5"><div class="text-2xl font-bold text-emerald-600">IPQC</div><p class="text-sm text-muted mt-1">{__('quality.ipqc')}</p></div>
          <div class="rounded-xl border p-5"><div class="text-2xl font-bold text-emerald-600">OQC</div><p class="text-sm text-muted mt-1">{__('quality.oqc')}</p></div>
        </div>
        <h2>{__('quality.testing_capabilities')}</h2>
        <div class="grid gap-4 sm:grid-cols-2 not-prose">
          <div class="rounded-xl border p-4"><Icon name="tabler:bolt" class="h-6 w-6 text-emerald-600 mb-2"/><h3 class="font-semibold">{__('quality.electrical_testing')}</h3><p class="text-sm text-muted">{__('quality.electrical_testing_text')}</p></div>
          <div class="rounded-xl border p-4"><Icon name="tabler:ruler" class="h-6 w-6 text-emerald-600 mb-2"/><h3 class="font-semibold">{__('quality.dimensional_inspection')}</h3><p class="text-sm text-muted">{__('quality.dimensional_inspection_text')}</p></div>
          <div class="rounded-xl border p-4"><Icon name="tabler:droplet" class="h-6 w-6 text-emerald-600 mb-2"/><h3 class="font-semibold">{__('quality.leak_testing')}</h3><p class="text-sm text-muted">{__('quality.leak_testing_text')}</p></div>
          <div class="rounded-xl border p-4"><Icon name="tabler:clock" class="h-6 w-6 text-emerald-600 mb-2"/><h3 class="font-semibold">{__('quality.durability_testing')}</h3><p class="text-sm text-muted">{__('quality.durability_testing_text')}</p></div>
        </div>
        <h2>{__('quality.warranty')}</h2>
        <p>{__('quality.warranty_text')}</p>
      </div>
    </div>
  </section>

  <section class="bg-slate-950 text-white">
    <div class="mx-auto max-w-3xl px-6 py-14 text-center lg:py-18">
      <h2 class="text-2xl font-semibold" style="font-family: 'Space Grotesk Variable', sans-serif;">{__('quality.cta_heading')}</h2>
      <p class="mt-4 text-base text-gray-400 max-w-xl mx-auto">{__('quality.cta_text')}</p>
      <div class="mt-6 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a href={L('/sample-request')} class="rounded-lg bg-teal-600 px-6 py-3 text-sm font-semibold text-white hover:bg-teal-500">{__('quality.request_samples')}</a>
        <a href={L('/inquiry')} class="rounded-lg border border-white/15 px-6 py-3 text-sm font-semibold text-white hover:bg-white/5">{__('quality.submit_inquiry')}</a>
      </div>
    </div>
  </section>
</Layout>
