---
import Layout from '~/layouts/InquiryLayout.astro';
import { Icon } from 'astro-icon/components';
import { useTranslations, defaultLang, localeLink } from '~/i18n/utils';

export interface Props {
  locale?: 'en' | 'ar' | 'es';
}

const { locale = defaultLang } = Astro.props;
const __ = useTranslations(locale);
const L = (path: string) => localeLink(path, locale);

const moqRows = [
  { type: 'Water Pumps', moq: '500-1000 pcs', sample: '7-10 days', production: '15-25 days' },
  { type: 'Fan Motors', moq: '300-500 pcs', sample: '10-15 days', production: '20-30 days' },
  { type: 'Cooling Pads', moq: '1000-2000 pcs', sample: '5-7 days', production: '10-20 days' },
  { type: 'Control Boards', moq: '300-500 pcs', sample: '15-20 days', production: '25-35 days' },
  { type: 'Structural Parts', moq: '200-500 pcs', sample: '10-15 days', production: '20-30 days' },
];
---

<Layout metadata={{ title: __('oem.title'), ignoreTitleTemplate: true }} locale={locale}>
  <section class="bg-slate-950 text-white">
    <div class="mx-auto max-w-3xl px-6 py-14 lg:py-18 text-center">
      <p class="text-sm font-medium text-teal-400">{__('oem.custom_manufacturing')}</p>
      <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl" style="font-family: 'Space Grotesk Variable', sans-serif; letter-spacing: -0.03em;">
        {__('oem.heading')}
      </h1>
      <p class="mt-4 text-lg text-gray-400 leading-relaxed max-w-xl mx-auto">
        {__('oem.hero_text')}
      </p>
    </div>
  </section>

  <section class="bg-white dark:bg-slate-900 border-b border-gray-100 dark:border-slate-800">
    <div class="mx-auto max-w-4xl px-6 py-12 lg:py-16">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6" style="font-family: 'Space Grotesk Variable', sans-serif;">{__('oem.why_choose')}</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="flex gap-3 rounded-xl border border-gray-200 p-5 dark:border-slate-700">
          <Icon name="tabler:settings" class="h-5 w-5 text-teal-600 mt-0.5 flex-shrink-0"/>
          <div><h3 class="text-sm font-semibold text-gray-900 dark:text-white">{__('oem.in_house_production')}</h3><p class="text-xs text-muted mt-1">{__('oem.in_house_production_text')}</p></div>
        </div>
        <div class="flex gap-3 rounded-xl border border-gray-200 p-5 dark:border-slate-700">
          <Icon name="tabler:tag" class="h-5 w-5 text-teal-600 mt-0.5 flex-shrink-0"/>
          <div><h3 class="text-sm font-semibold text-gray-900 dark:text-white">{__('oem.flexible_moq')}</h3><p class="text-xs text-muted mt-1">{__('oem.flexible_moq_text')}</p></div>
        </div>
        <div class="flex gap-3 rounded-xl border border-gray-200 p-5 dark:border-slate-700">
          <Icon name="tabler:clock" class="h-5 w-5 text-teal-600 mt-0.5 flex-shrink-0"/>
          <div><h3 class="text-sm font-semibold text-gray-900 dark:text-white">{__('oem.dedicated_pm')}</h3><p class="text-xs text-muted mt-1">{__('oem.dedicated_pm_text')}</p></div>
        </div>
        <div class="flex gap-3 rounded-xl border border-gray-200 p-5 dark:border-slate-700">
          <Icon name="tabler:shield" class="h-5 w-5 text-teal-600 mt-0.5 flex-shrink-0"/>
          <div><h3 class="text-sm font-semibold text-gray-900 dark:text-white">{__('oem.ip_protection')}</h3><p class="text-xs text-muted mt-1">{__('oem.ip_protection_text')}</p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 dark:bg-slate-800/30 border-b border-gray-100 dark:border-slate-800">
    <div class="mx-auto max-w-4xl px-6 py-12 lg:py-16">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6" style="font-family: 'Space Grotesk Variable', sans-serif;">{__('oem.what_we_customize')}</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900/50">
          <Icon name="tabler:tool" class="h-7 w-7 text-teal-500 mb-3"/>
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white">{__('oem.specifications')}</h3>
          <ul class="mt-2 space-y-1 text-xs text-muted">
            <li>&bull; {__('oem.spec_voltage')}</li>
            <li>&bull; {__('oem.spec_rpm')}</li>
            <li>&bull; {__('oem.spec_dimensions')}</li>
            <li>&bull; {__('oem.spec_materials')}</li>
            <li>&bull; {__('oem.spec_mounting')}</li>
          </ul>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900/50">
          <Icon name="tabler:tag" class="h-7 w-7 text-teal-500 mb-3"/>
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white">{__('oem.branding_labels')}</h3>
          <ul class="mt-2 space-y-1 text-xs text-muted">
            <li>&bull; {__('oem.brand_logo')}</li>
            <li>&bull; {__('oem.brand_engraving')}</li>
            <li>&bull; {__('oem.brand_nameplates')}</li>
            <li>&bull; {__('oem.brand_barcodes')}</li>
            <li>&bull; {__('oem.brand_multilang')}</li>
          </ul>
        </div>
        <div class="rounded-xl border border-gray-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-900/50">
          <Icon name="tabler:package" class="h-7 w-7 text-teal-500 mb-3"/>
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white">{__('oem.packaging')}</h3>
          <ul class="mt-2 space-y-1 text-xs text-muted">
            <li>&bull; {__('oem.pack_retail')}</li>
            <li>&bull; {__('oem.pack_blister')}</li>
            <li>&bull; {__('oem.pack_bulk')}</li>
            <li>&bull; {__('oem.pack_color')}</li>
            <li>&bull; {__('oem.pack_eco')}</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white dark:bg-slate-900 border-b border-gray-100 dark:border-slate-800">
    <div class="mx-auto max-w-4xl px-6 py-12 lg:py-16">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6" style="font-family: 'Space Grotesk Variable', sans-serif;">{__('oem.how_it_works')}</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <div class="relative">
          <span class="text-2xl font-bold text-teal-600/20">01</span>
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white mt-1">{__('oem.step1_title')}</h3>
          <p class="text-xs text-muted mt-1">{__('oem.step1_text')}</p>
        </div>
        <div class="relative">
          <span class="text-2xl font-bold text-teal-600/20">02</span>
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white mt-1">{__('oem.step2_title')}</h3>
          <p class="text-xs text-muted mt-1">{__('oem.step2_text')}</p>
        </div>
        <div class="relative">
          <span class="text-2xl font-bold text-teal-600/20">03</span>
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white mt-1">{__('oem.step3_title')}</h3>
          <p class="text-xs text-muted mt-1">{__('oem.step3_text')}</p>
        </div>
        <div class="relative">
          <span class="text-2xl font-bold text-teal-600/20">04</span>
          <h3 class="text-sm font-semibold text-gray-900 dark:text-white mt-1">{__('oem.step4_title')}</h3>
          <p class="text-xs text-muted mt-1">{__('oem.step4_text')}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-gray-50 dark:bg-slate-800/30 border-b border-gray-100 dark:border-slate-800">
    <div class="mx-auto max-w-4xl px-6 py-12 lg:py-16">
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white mb-6" style="font-family: 'Space Grotesk Variable', sans-serif;">{__('oem.moq_timeline')}</h2>
      <div class="overflow-hidden rounded-xl border border-gray-200 dark:border-slate-700">
        <table class="w-full text-sm">
          <thead><tr class="bg-gray-50 dark:bg-slate-800"><th class="px-6 py-3 text-left font-medium text-gray-900 dark:text-white">{__('oem.table_product_type')}</th><th class="px-6 py-3 text-left font-medium text-gray-900 dark:text-white">{__('oem.table_moq')}</th><th class="px-6 py-3 text-left font-medium text-gray-900 dark:text-white">{__('oem.table_sample_time')}</th><th class="px-6 py-3 text-left font-medium text-gray-900 dark:text-white">{__('oem.table_production_time')}</th></tr></thead>
          <tbody class="divide-y divide-gray-100 dark:divide-slate-700">
            {moqRows.map((row) => (
              <tr class="bg-white dark:bg-slate-900/50"><td class="px-6 py-3 text-muted">{row.type}</td><td class="px-6 py-3">{row.moq}</td><td class="px-6 py-3 text-muted">{row.sample}</td><td class="px-6 py-3 text-muted">{row.production}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-muted mt-4">{__('oem.table_disclaimer')}</p>
    </div>
  </section>

  <section class="bg-slate-950 text-white">
    <div class="mx-auto max-w-3xl px-6 py-14 text-center lg:py-18">
      <h2 class="text-2xl font-semibold tracking-tight" style="font-family: 'Space Grotesk Variable', sans-serif; letter-spacing: -0.02em;">{__('oem.cta_heading')}</h2>
      <p class="mt-4 text-base text-gray-400 max-w-xl mx-auto leading-relaxed">{__('oem.cta_text')}</p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a href={L('/inquiry')} class="inline-flex items-center gap-2 rounded-lg bg-teal-600 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-teal-500">
          <Icon name="tabler:mail" class="h-4 w-4"/> {__('oem.start_inquiry')}
        </a>
        <a href={L('/sample-request')} class="inline-flex items-center gap-2 rounded-lg border border-white/15 px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-white/5">
          {__('oem.request_samples')} <Icon name="tabler:arrow-right" class="h-4 w-4"/>
        </a>
      </div>
    </div>
  </section>
</Layout>
