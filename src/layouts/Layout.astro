---
import '~/assets/styles/tailwind.css';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import StructuredData from '~/components/common/StructuredData.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';
import { getDirection, getLangAttribute, supportedLocales, defaultLang, localePath, siteUrl } from '~/i18n/utils';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const currentLocale = (Astro.currentLocale as string) || defaultLang;
const language = getLangAttribute(currentLocale);
const textDirection = getDirection(currentLocale);
const baseSiteUrl = siteUrl(Astro.site);
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <!-- Manual og:locale (placed before Metadata so compressor keeps this one) -->
    <meta property="og:locale" content={currentLocale === 'en' ? 'en_US' : currentLocale === 'ar' ? 'ar_SA' : 'es_MX'} />
    <Metadata {...metadata} locale={currentLocale} />
    <SiteVerification />
    <Analytics />
    <StructuredData type="Organization" />

    <!-- hreflang alternate links for SEO -->
    {supportedLocales.map((loc) => {
      const basePath = Astro.url.pathname.replace(/^\/(ar|es)\//, '/').replace(/^\/(ar|es)$/, '/');
      const href = loc === defaultLang ? `${baseSiteUrl}${basePath}` : `${baseSiteUrl}${localePath(basePath, loc)}`;
      return <link rel="alternate" hreflang={loc === 'en' ? 'en' : loc} href={href} />;
    })}
    <link rel="alternate" hreflang="x-default" href={`${baseSiteUrl}${Astro.url.pathname.replace(/^\/(ar|es)\//, '/').replace(/^\/(ar|es)$/, '/')}`} />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-teal-600 focus:text-white focus:rounded-lg">Skip to content</a>
    <slot />

    <BasicScripts />

    <!-- Browser language detection — auto-redirect to user's preferred locale on first visit -->
    <script is:inline>
      (function(){try{const s=localStorage.getItem('evapfit_lang');if(s)return;const p=window.location.pathname;if(p.startsWith('/ar/')||p.startsWith('/es/'))return;const n=(navigator.language||'').toLowerCase();let t='';if(n.startsWith('ar'))t='ar';else if(n.startsWith('es'))t='es';if(t){localStorage.setItem('evapfit_lang',t);window.location.href='/'+t+(p==='/'?'':p)}}catch{/* Storage may be disabled. */}})();
    </script>
  </body>
</html>
