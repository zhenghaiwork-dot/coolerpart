---
import '~/assets/styles/tailwind.css';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';
import StructuredData from '~/components/common/StructuredData.astro';

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';
import { getDirection, getLangAttribute, supportedLocales, defaultLang, localePath, siteUrl } from '~/i18n/utils';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const currentLocale = (Astro.currentLocale as string) || defaultLang;
const language = getLangAttribute(currentLocale);
const textDirection = getDirection(currentLocale);
const baseSiteUrl = siteUrl(Astro.site);
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    <Analytics />
    <StructuredData type="Organization" />

    <link rel="preconnect" href="https://images.unsplash.com" />

    <!-- hreflang alternate links for SEO -->
    {supportedLocales.map((loc) => {
      const basePath = Astro.url.pathname.replace(/^\/(ar|es)\//, '/').replace(/^\/(ar|es)$/, '/');
      const href = loc === defaultLang ? `${baseSiteUrl}${basePath}` : `${baseSiteUrl}${localePath(basePath, loc)}`;
      return <link rel="alternate" hreflang={loc === 'en' ? 'en' : loc} href={href} />;
    })}
    <link rel="alternate" hreflang="x-default" href={`${baseSiteUrl}${Astro.url.pathname.replace(/^\/(ar|es)\//, '/').replace(/^\/(ar|es)$/, '/')}`} />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <BasicScripts />

    <!-- Browser language detection — auto-redirect to user's preferred locale on first visit -->
    <script is:inline>
      (function(){try{var s=localStorage.getItem('evapfit_lang');if(s)return;var p=window.location.pathname;if(p.startsWith('/ar/')||p.startsWith('/es/'))return;var n=(navigator.language||'').toLowerCase();var t='';if(n.startsWith('ar'))t='ar';else if(n.startsWith('es'))t='es';if(t){localStorage.setItem('evapfit_lang',t);window.location.href='/'+t+(p==='/'?'':p)}}catch(_){}})();
    </script>
  </body>
</html>
